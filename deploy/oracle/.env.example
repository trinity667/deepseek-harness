# Compose interpolation only (not injected into any container).
# Copy to deploy/oracle/.env and fill in; bootstrap.sh writes it for you.

# quick: no domain, protected *.trycloudflare.com tunnels (one-time PIN to ADMIN_EMAIL)
# named: your own Cloudflare domain and remote-managed tunnel
COMPOSE_PROFILES=quick

# Public host name of dsh: dsh.example.com (named) or the Quick Tunnel host.
DSH_PUBLIC_HOST=

# The only address allowed through the Quick Tunnels.
ADMIN_EMAIL=

# named only: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=

# Copy to deploy/oracle/.env (never commit it) and fill in every value.

# Public host name Cloudflare routes to dsh, e.g. dsh.example.com.
DSH_PUBLIC_HOST=

# FreeLLMAPI: storage encryption key for provider API keys.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# FreeLLMAPI unified key that dsh sends as its bearer token. Copy it from the
# FreeLLMAPI dashboard after the first start (Settings → API key).
FREE_LLM_API_KEY=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=

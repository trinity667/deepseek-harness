# Compose interpolation only (not injected into any container).
# Copy to deploy/oracle/.env and fill in; bootstrap.sh writes it for you.

# Public host name Cloudflare routes to dsh, e.g. dsh.example.com.
DSH_PUBLIC_HOST=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
CLOUDFLARE_TUNNEL_TOKEN=
